# 文件内容和数据库分开配置；SQLite 文件名固定为 zerodrive.db。
FILES_DIR=./data/files
DATABASE_DIR=./data/database

# Single admin (development: plain password comparison — replace with hash in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT (use a long random string in production)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=525600

# CORS (dev frontend)
CORS_ORIGINS=http://localhost:5173

BOT_DOWNLOAD_EXPIRE_SECONDS=300

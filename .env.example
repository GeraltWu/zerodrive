# Docker Compose 必填。请复制为 .env，并替换成自己的值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
# 正式 HTTPS 部署改为 true；本机 HTTP 调试保持 false。
SESSION_COOKIE_SECURE=false

BOT_DOWNLOAD_EXPIRE_SECONDS=300

PORT=8600
# Docker 宿主机上的两个持久化目录，可以放在同一个父目录下。
HOST_FILES_DIR=./data/files
HOST_DATABASE_DIR=./data/database
CORS_ORIGINS=http://localhost
# 正式部署填写外部可访问的 HTTPS 根地址，不要以 / 结尾。
PUBLIC_BASE_URL=
